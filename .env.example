PORT=3001

# Gemini API Key (backend tarafında kullanılır)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Geliştirici kaydı için gizli kod
VITE_DEVELOPER_ACCESS_CODE="YOUR_DEVELOPER_ACCESS_CODE"
